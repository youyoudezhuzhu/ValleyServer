#!/bin/bash
# install_init — 安装文件落地【前】执行：只做前置校验，不产生副作用。
# 失败时把原因写进 $TRIM_TEMP_LOGFILE 并 exit 1，应用中心会展示给用户。

APP="${TRIM_APPDEST:-/var/apps/valleyserver/target}"
LOG="${TRIM_TEMP_LOGFILE:-/tmp/valleyserver-install.log}"
fail() { echo "$1" >> "$LOG" 2>/dev/null; echo "$1" >&2; exit 1; }

echo "valleyserver install_init: $(date '+%F %T')" >> "$LOG" 2>/dev/null

# 1) Python 解释器（本应用只使用标准库）
PY=""
for c in /var/apps/python312/target/bin/python3 /var/apps/python312/target/bin/python3.12 python3.12 python3; do
    if command -v "$c" >/dev/null 2>&1 && "$c" -c 'import sys; sys.exit(0 if sys.version_info>=(3,10) else 1)' 2>/dev/null; then
        PY="$c"; break
    fi
done
[ -z "$PY" ] && fail "未找到 Python 3.10+。请先在飞牛应用中心安装 python312，然后重新安装本应用。"
echo "python: $PY ($("$PY" --version 2>&1))" >> "$LOG" 2>/dev/null

# 2) 原生运行环境预检。
#    这里只做"信息性检查"，都不阻断安装 —— 缺失的东西可以在管理界面里补。
#
#    · 显示栈（Xvfb/openbox/x11vnc/websockify/noVNC）：安装回调会自动下载并解包到应用目录
#    · 游戏本体（含 SMAPI）：由用户自备，在管理界面「系统」页上传
if command -v apt-get >/dev/null 2>&1; then
    echo "apt-get: 可用（显示组件将由安装回调下载并解包到应用目录，不修改系统包状态）" >> "$LOG" 2>/dev/null
else
    echo "警告：未检测到 apt-get，无法自动获取虚拟显示组件。" >> "$LOG" 2>/dev/null
    echo "      可以改用系统已装的 Xvfb/x11vnc/websockify/openbox，并在「配置」页把显示组件来源改为「系统已装」。" >> "$LOG" 2>/dev/null
fi
echo "提示：游戏本体与 SMAPI 需自行提供（本项目不再分发），安装后在管理界面「系统」页上传。" >> "$LOG" 2>/dev/null

# 3) 数据目录可写性预检
for d in "${TRIM_PKGHOME:-/vol1/@apphome/valleyserver}" "${TRIM_PKGVAR:-/vol1/@appdata/valleyserver}"; do
    mkdir -p "$d" 2>/dev/null
    if [ ! -w "$d" ]; then
        fail "数据目录不可写：$d。请检查存储空间与权限。"
    fi
done

echo "install_init OK" >> "$LOG" 2>/dev/null
exit 0
