appname               = valleyserver
version               = 0.1.1
display_name          = ValleyServer 管理器
desc                  = 星露谷物语无人值守多人服务器（ValleyServer 2.x）的原生管理器。基于 Docker 运行游戏客户端 + SMAPI + 自动化 MOD，提供服务器控制台、存档管理、MOD 管理、自动快照、版本固定与回滚、日志诊断与无人值守恢复能力。游戏数据与小程序生命周期分离，卸载或升级默认保留存档与 MOD。
source                = thirdparty
platform              = x86
install_dep_apps      = python312
maintainer            = youyoudezhuzhu
maintainer_url        = https://github.com/youyoudezhuzhu/ValleyServer
distributor           = youyoudezhuzhu
distributor_url       = https://github.com/youyoudezhuzhu/ValleyServer
desktop_uidir         = ui
desktop_applaunchname = valleyserver.Application
service_port          = 18242
checkport             = true
ctl_stop              = true
micro_app             = true
disable_authorization_path = true
os_min_version        = 1.0.0
